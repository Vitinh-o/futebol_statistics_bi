model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["pBaseUrl"]

ref table dClubes
ref table dJogadores
ref table dJogador_A
ref table dJogador_B
ref table fPartidas
ref table dRodadas
ref table fEstatisticasJogador
ref table dCalendario
ref table _Medidas

ref cultureInfo en-US

