	measure Líder =
			VAR TabelaClubes =
			    ADDCOLUMNS(
			        ALLSELECTED(dClubes),
			        "@Score",
			            [Pontos Totais] * 1000000
			                + [Vitórias] * 10000
			                + ([Saldo de Gols] + 500) * 100
			                + [Gols Pró]
			    )
			VAR TabelaOrdenada =
			    TOPN(1, TabelaClubes, [@Score], DESC)
			RETURN
			    SELECTCOLUMNS(TabelaOrdenada, "Nome", dClubes[nome_clube])
		displayFolder: 01. Campeonato
		lineageTag: 395ab739-56a1-4e08-be0d-09bcbde85eeb

	measure 'Melhor Ataque' =
			VAR TabelaAtaques =
			    ADDCOLUMNS(
			        ALLSELECTED(dClubes),
			        "@GolsPro", [Gols Pró]
			    )
			VAR TopAtaque =
			    TOPN(1, TabelaAtaques, [@GolsPro], DESC)
			RETURN
			    SELECTCOLUMNS(TopAtaque, "Nome", dClubes[nome_clube])
		displayFolder: 01. Campeonato
		lineageTag: d3825b8b-eff5-4d47-97fb-a7492d6c96f8

	measure 'Líder (Card)' =
			VAR TabelaClubes =
			    ADDCOLUMNS(
			        ALLSELECTED(dClubes),
			        "@Score",
			            [Pontos Totais] * 1000000
			                + [Vitórias] * 10000
			                + ([Saldo de Gols] + 500) * 100
			                + [Gols Pró]
			    )
			VAR TopClube =
			    TOPN(1, TabelaClubes, [@Score], DESC)
			VAR Nome =
			    SELECTCOLUMNS(TopClube, "Nome", dClubes[nome_clube])
			VAR Pts =
			    CALCULATE([Pontos Totais], TopClube)
			RETURN
			    IF(
			        NOT ISEMPTY(TopClube),
			        Nome & " (" & FORMAT(Pts, "#,0") & " pts)"
			    )
		displayFolder: 01. Campeonato
		lineageTag: 53093263-b83b-4121-9ade-24b050627988

	measure 'Melhor Ataque (Card)' =
			VAR TabelaAtaques =
			    ADDCOLUMNS(
			        ALLSELECTED(dClubes),
			        "@GolsPro", [Gols Pró]
			    )
			VAR TopAtaque =
			    TOPN(1, TabelaAtaques, [@GolsPro], DESC)
			VAR Nome =
			    SELECTCOLUMNS(TopAtaque, "Nome", dClubes[nome_clube])
			VAR Gols =
			    CALCULATE([Gols Pró], TopAtaque)
			RETURN
			    IF(
			        NOT ISEMPTY(TopAtaque),
			        Nome & " (" & FORMAT(Gols, "#,0") & " gols)"
			    )
		displayFolder: 01. Campeonato
		lineageTag: 306aecc1-40e1-4362-a0a8-3f9b5f3ec5db

	measure 'Artilheiro (Card)' =
			VAR TabelaJogadores =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED(dJogadores),
			            "@Valor", [Gols],
			            "@Minutos", [Minutos Jogados]
			        ),
			        NOT ISBLANK([@Valor]) && [@Minutos] > 0
			    )
			VAR TopJogador =
			    TOPN(1, TabelaJogadores, [@Valor], DESC, [@Minutos], DESC, dJogadores[id_jogador], ASC)
			VAR Nome =
			    MAXX(TopJogador, dJogadores[nome_jogador])
			VAR Valor =
			    MAXX(TopJogador, [@Valor])
			RETURN
			    IF(
			        NOT ISEMPTY(TopJogador),
			        Nome & " (" & FORMAT(Valor, "#,0") & " gols)"
			    )
		displayFolder: 02. Jogadores
		lineageTag: 16bd83d6-6da2-4524-92ef-97191f669f96

