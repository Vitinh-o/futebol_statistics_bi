	measure 'Líder de G+A por 90min (Card)' =
			VAR TabelaJogadores =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED(dJogadores),
			            "@Valor", [G+A por 90min],
			            "@Minutos", [Minutos Jogados]
			        ),
			        NOT ISBLANK([@Valor]) && [@Minutos] > 0
			    )
			VAR TopJogador =
			    TOPN(1, TabelaJogadores, [@Valor], DESC, [@Minutos], DESC, dJogadores[id_jogador], ASC)
			VAR Nome =
			    MAXX(TopJogador, dJogadores[nome_jogador])
			VAR Valor =
			    MAXX(TopJogador, [@Valor])
			RETURN
			    IF(
			        NOT ISEMPTY(TopJogador),
			        Nome & " (" & FORMAT(Valor, "0.00") & " /90)"
			    )
		displayFolder: 02. Jogadores
		lineageTag: 0c544ab7-a887-4e65-80d5-06e3299e16c2

	measure 'Aproveitamento Líder %' =
			VAR TabelaClubes =
			    ADDCOLUMNS(
			        ALLSELECTED(dClubes),
			        "@Score",
			            [Pontos Totais] * 1000000
			                + [Vitórias] * 10000
			                + ([Saldo de Gols] + 500) * 100
			                + [Gols Pró]
			    )
			VAR TopClube =
			    TOPN(1, TabelaClubes, [@Score], DESC)
			RETURN
			    CALCULATE([Aproveitamento %], TopClube)
		formatString: 0.0%
		displayFolder: 01. Campeonato
		lineageTag: dc8d66f2-ef6a-433a-b5ae-fa657b49b83c

	measure 'Média Gols por Partida' =
