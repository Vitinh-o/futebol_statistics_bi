/// Tabela dedicada para organização de todas as medidas DAX do modelo
table _Medidas
	lineageTag: f63e0794-a83e-4bf0-bc5e-49690a0dfbf4

	measure 'Pontos Totais' = SUM(fPartidas[pontos])
		formatString: #,0
		displayFolder: 01. Campeonato
		lineageTag: 3b705691-efa4-42b2-96da-38b5b476ccab

	measure 'Jogos Disputados' =
			CALCULATE(
			    COUNTROWS(fPartidas),
			    fPartidas[status_jogo] = "FT"
			)
		formatString: #,0
		displayFolder: 01. Campeonato
		lineageTag: cc4d491d-0532-456f-b2b1-f2f3da9498cc

	measure Vitórias =
			CALCULATE(
			    COUNTROWS(fPartidas),
			    fPartidas[resultado] = "V",
			    fPartidas[status_jogo] = "FT"
			)
		formatString: #,0
		displayFolder: 01. Campeonato
		lineageTag: e19e80fc-bf53-42ea-a659-9e8c38db71a3

	measure Empates =
			CALCULATE(
			    COUNTROWS(fPartidas),
			    fPartidas[resultado] = "E",
			    fPartidas[status_jogo] = "FT"
			)
		formatString: #,0
		displayFolder: 01. Campeonato
		lineageTag: 78166cda-5000-4d9d-8058-9c025ce913e9

	measure Derrotas =
			CALCULATE(
			    COUNTROWS(fPartidas),
			    fPartidas[resultado] = "D",
			    fPartidas[status_jogo] = "FT"
			)
		formatString: #,0
		displayFolder: 01. Campeonato
		lineageTag: 1ae0ab9e-7302-4e2e-a5ba-4e73218d80e0

	measure 'Gols Pró' = SUM(fPartidas[gols_pro])
		formatString: #,0
		displayFolder: 01. Campeonato
		lineageTag: fc7eb728-7dae-4e33-9b81-38800474faf3

	measure 'Gols Contra' = SUM(fPartidas[gols_contra])
		formatString: #,0
		displayFolder: 01. Campeonato
		lineageTag: 45e796ad-ef93-44ea-a472-bd819b6aa698

	measure 'Saldo de Gols' = [Gols Pró] - [Gols Contra]
		formatString: +#,0;-#,0;0
		displayFolder: 01. Campeonato
		lineageTag: 0874addd-e402-467d-ba3c-c19595e1f3c2

	measure 'Aproveitamento %' = DIVIDE([Pontos Totais], [Jogos Disputados] * 3, 0)
		formatString: 0.0%
		displayFolder: 01. Campeonato
		lineageTag: 069ef1e2-5c8c-4343-81ec-8efd456e27c3

	measure 'Média Gols/Jogo' = DIVIDE([Gols Pró], [Jogos Disputados], 0)
		formatString: 0.00
		displayFolder: 01. Campeonato
		lineageTag: e07248b4-e41c-40a7-b0f8-478d94877f59

	measure 'Pontos Acumulados' =
			VAR RodadaMax = MAX(dRodadas[rodada_num])
			RETURN
			CALCULATE(
			    [Pontos Totais],
			    FILTER(
			        ALLSELECTED(dRodadas[rodada_num]),
			        dRodadas[rodada_num] <= RodadaMax
			    )
			)
		formatString: #,0
		displayFolder: 01. Campeonato
		lineageTag: 3a5f26c7-58ec-4bb9-8f82-67c672f53a42

	measure 'Posição Classificação' =
			VAR ClubeSelecionado = HASONEVALUE(dClubes[id_clube])
			RETURN
			IF(
			    ClubeSelecionado,
			    RANKX(
			        ALLSELECTED(dClubes),
			        [Pontos Totais] * 1000000
			            + [Vitórias] * 10000
			            + ([Saldo de Gols] + 500) * 100
			            + [Gols Pró],
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: #,0
		displayFolder: 01. Campeonato
		lineageTag: aec253ce-7160-4d16-8aa7-bb2ae2c523a3

	measure 'Minutos Jogados' = SUM(fEstatisticasJogador[minutos_jogados])
