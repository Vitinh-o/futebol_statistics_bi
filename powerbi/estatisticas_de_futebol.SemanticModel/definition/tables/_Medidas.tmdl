	measure 'H2H Diferença Formatada (A - B)' =
			VAR Metrica = SELECTEDVALUE(dMetricas_H2H[Metrica])
			VAR ValA = [H2H Valor (A)]
			VAR ValB = [H2H Valor (B)]
			VAR Diff = ValA - ValB
			RETURN
			IF(
			    ISBLANK(ValA) || ISBLANK(ValB),
			    "-",
			    SWITCH(
			        Metrica,
			        "Nota Média", FORMAT(Diff, "+0.00;-0.00;0.00"),
			        "Gols / 90min", FORMAT(Diff, "+0.00;-0.00;0.00"),
			        "Assistências / 90min", FORMAT(Diff, "+0.00;-0.00;0.00"),
			        "G + A / 90min", FORMAT(Diff, "+0.00;-0.00;0.00"),
			        "Finalizações no Gol / 90", FORMAT(Diff, "+0.00;-0.00;0.00"),
			        "Passes Chave / 90min", FORMAT(Diff, "+0.00;-0.00;0.00"),
			        "Precisão de Passe %", FORMAT(Diff, "+0.0%;-0.0%;0.0%"),
			        FORMAT(Diff, "+#,0;-#,0;0")
			    )
			)
		displayFolder: 03. Head-to-Head
		lineageTag: cebf3684-f5f6-457f-a649-f20d2d851ff7

	measure 'H2H Vantagem' =
			VAR ValA = [H2H Valor (A)]
			VAR ValB = [H2H Valor (B)]
			VAR NomeA = SELECTEDVALUE(dJogador_A[nome_jogador], "Jogador A")
			VAR NomeB = SELECTEDVALUE(dJogador_B[nome_jogador], "Jogador B")
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(ValA) || ISBLANK(ValB), "-",
			    ValA > ValB, NomeA & " (A)",
			    ValB > ValA, NomeB & " (B)",
			    "Empate"
			)
		displayFolder: 03. Head-to-Head
		lineageTag: d5b5e42e-f2e3-4fac-ae26-3358e481c2a8

	measure 'H2H Cor Vantagem' =
			VAR ValA = [H2H Valor (A)]
			VAR ValB = [H2H Valor (B)]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(ValA) || ISBLANK(ValB), "#64748B",
			    ValA > ValB, "#059669",
			    ValB > ValA, "#2563EB",
			    "#64748B"
			)
		displayFolder: 03. Head-to-Head
		lineageTag: 54e54a70-961e-4171-8c9b-e9d8021c2c74

