			VAR Val = [H2H Valor (A)]
			RETURN
			IF(
			    ISBLANK(Val),
			    "-",
			    SWITCH(
			        Metrica,
			        "Nota Média", FORMAT(Val, "0.00"),
			        "Gols / 90min", FORMAT(Val, "0.00"),
			        "Assistências / 90min", FORMAT(Val, "0.00"),
