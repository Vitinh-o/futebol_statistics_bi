	measure 'Líder de G+A por 90min (Card)' =
			VAR TabelaJogadores =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED(dJogadores),
			            "@Valor", [G+A por 90min],
			            "@Minutos", [Minutos Jogados]
			        ),
			        NOT ISBLANK([@Valor]) && [@Minutos] > 0
			    )
			VAR TopJogador =
			    TOPN(1, TabelaJogadores, [@Valor], DESC, [@Minutos], DESC, dJogadores[id_jogador], ASC)
			VAR Nome =
			    MAXX(TopJogador, dJogadores[nome_jogador])
			VAR Valor =
			    MAXX(TopJogador, [@Valor])
			RETURN
			    IF(
			        NOT ISEMPTY(TopJogador),
			        Nome & " (" & FORMAT(Valor, "0.00") & " /90)"
			    )
		displayFolder: 02. Jogadores
		lineageTag: 0c544ab7-a887-4e65-80d5-06e3299e16c2

	column __Dummy
		isHidden
		isNameInferred
		sourceColumn: [__Dummy]

	partition _Medidas = calculated
		mode: import
		source = ROW("__Dummy", BLANK())

